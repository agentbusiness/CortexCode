# Copy to .env.release (git-ignored) for the release scripts (scripts/release-*.sh).

# A GitHub token of the repository's owner that may create releases and upload files
# (fine-grained: Contents read and write on the repository).
GITHUB_TOKEN=

# Where releases go.
# RELEASE_REPO=agentbusiness/CortexCode

# Platforms to build (Linux ones in Docker, which must be running).
# RELEASE_PLATFORMS="darwin-arm64 linux-arm64 linux-x64"

# A macOS .dmg in the app release: yes once the app is signed (until then macOS users use npx).
# RELEASE_DMG=no

# Names no released file may hold: an extended regular expression, any case (required). Every
# package, archive and the npm package is scanned before upload.
RELEASE_FORBIDDEN=

# npm token for scripts/release-npm.sh (else this Mac's npm login).
# NPM_TOKEN=
