          ],
          "needle": "Math.random",
          "regex": "(token|secret|nonce|salt|session|otp|code|reset|key|id)\\w*\\s*[:=][^\\n]*Math\\.random\\s*\\(|Math\\.random\\s*\\(\\)[^\\n]*(toString\\(36\\)|token|secret|nonce)"
        },
