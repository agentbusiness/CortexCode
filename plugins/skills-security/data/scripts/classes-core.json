    {
      "id": "business-logic",
      "name": "Business logic, state and quantities",
      "applies": {
        "content": [
          "(?i)\\b(price|amount|quantity|qty|balance|credits?|coupon|discount|invoice|payment|checkout|refund|transfer|approve|approval|subscription|wallet)\\b"
        ]
      },
      "invariant": "Every state transition, quantity and price is decided by the server from trusted data, in one atomic step, and cannot be replayed, skipped or reversed outside the intended flow.",
      "look": [
        "Numbers from the request (quantity, amount, price, discount, page size): negative, zero, huge, fractional, string typed; where are they bounded, and where is the total computed?",
        "State machines (order, approval, subscription, verification): can a step be skipped by calling a later endpoint, repeated (replay of a completed flow), or reversed (cancel after shipping)?",
        "Check-then-act without a transaction or lock (balance check then debit; coupon valid then redeem): two concurrent requests.",
        "Expiry and time: comparisons against now, clock source, time zones, exact boundary; tokens or coupons after expiry.",
        "Defaults when configuration, a flag or a dependency is missing: which way does it fail (open or closed)?",
        "Data trusted because it was validated on the way in: another code path (import, admin, migration, plugin) writes the same record."
      ],
      "counts": "A caller changes an amount, skips a step, repeats a one-time action or reaches an invalid state with a concrete gain or a loss for someone else.",
      "hardening": "A missing upper bound with no effect beyond the caller's own data; a race you cannot make concrete in code.",
