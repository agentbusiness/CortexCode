        },
        {
          "name": "status set from the request",
          "langs": [
            "any"
          ],
          "needle": "status",
          "regex": "(?i)\\.(status|state)\\s*=\\s*(req(uest)?\\.|params\\[|data\\[|body\\[|payload\\[)|[\"'](status|state)[\"']\\s*:\\s*req(uest)?\\."
        }
      ]
    },
    {
      "id": "data-exposure",
