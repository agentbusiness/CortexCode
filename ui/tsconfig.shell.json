{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.shell.tsbuildinfo",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "shell/*.js",
    "shell/*.cjs",
    "plugins/*/shell-module/*.js"
  ]
}