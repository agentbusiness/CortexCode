#!/bin/sh
# Start CortexCode from this repository exactly as the macOS app starts: build the app (the frame,
# the UI, every plugin built and packed, cx, cortex-pack and the source) into build/ with
# scripts/build-app.sh, then run it. Its first start installs the packed plugins into ~/.cortexcode,
# syncs the source into ~/.cortexcode/code and puts cx and cortex-pack into ~/.cortexcode/bin, as the
# downloaded app does. A plugin whose source did not change keeps its package, and a start with
# nothing changed since the last complete build (build/.stamp) skips the build altogether.
#
# Usage: cortexcode [frame options, e.g. --headless or --safe]   (a link to this file works too)
self="$0"
# Follow links (e.g. ~/.local/bin/cortexcode) to this file in the repository.
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
cd "$(dirname "$self")" || exit 1
scripts/build-app.sh build || exit 1
# The development start runs this build, never a frame an update staged in ~/.cortexcode/frame.
export CORTEX_NO_HANDOVER=1
exec build/CortexCode.app/Contents/MacOS/CortexCode "$@"
